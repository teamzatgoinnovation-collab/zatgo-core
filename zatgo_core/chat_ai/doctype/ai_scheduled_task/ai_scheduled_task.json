   "label": "Run As",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
   "description": "The task runs with this user's permissions and sees only what they may see."
  },
  {
   "fieldname": "prompt",
   "fieldtype": "Long Text",
   "label": "What should ZatGo AI do?",
   "reqd": 1,
   "description": "Write it like a message to the assistant, e.g. 'List items below their reorder level and the 5 biggest shortages'. Runs read-only: it can look things up and report, never create or change records."
  },
  {
   "fieldname": "schedule_section",
   "fieldtype": "Section Break",
   "label": "Schedule"
  },
  {
   "fieldname": "frequency",
