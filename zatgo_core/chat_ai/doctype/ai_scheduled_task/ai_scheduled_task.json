   "options": "Monday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday",
   "default": "Monday",
   "depends_on": "eval:doc.frequency=='Weekly'"
  },
  {
   "fieldname": "day_of_month",
   "fieldtype": "Int",
   "label": "Day of month (1-28)",
   "default": "1",
   "depends_on": "eval:doc.frequency=='Monthly'"
