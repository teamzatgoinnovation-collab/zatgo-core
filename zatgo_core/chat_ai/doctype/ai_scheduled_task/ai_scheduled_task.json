   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "time_of_day",
   "fieldtype": "Time",
   "label": "Time of day",
   "default": "08:00:00",
   "depends_on": "eval:doc.frequency!='Hourly'"
  },
  {
   "fieldname": "column_break_sched",
   "fieldtype": "Column Break",
   "label": ""
