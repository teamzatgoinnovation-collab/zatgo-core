  "fields": [
    {
      "fieldname": "general_tab",
      "fieldtype": "Tab Break",
      "label": "General"
    },
    {
      "fieldname": "type_section",
      "fieldtype": "Section Break",
      "label": "Type of POS"
    },
    {
      "fieldname": "pos_type",
      "fieldtype": "Select",
      "label": "POS Type",
      "options": "\nRestaurant\nCafe\nSupermarket\nGeneral Retail\nPharmacy (coming soon)\nElectrical (coming soon)",
      "description": "Restaurant and Cafe: tables, orders and kitchen display. Supermarket and General Retail: barcode counter selling, products and stock. Pharmacy and Electrical are not available yet. Saving a type switches the matching industry on (System Manager only). Left empty, the type follows the industries switched on."
    },
    {
      "fieldname": "defaults_section",
      "fieldtype": "Section Break",
      "label": "Sale defaults"
    },
    {
      "fieldname": "default_warehouse",
      "fieldtype": "Link",
      "label": "Default Warehouse",
      "options": "Warehouse"
    },
    {
      "fieldname": "default_price_list",
      "fieldtype": "Link",
      "label": "Default Price List",
      "options": "Price List"
    },
    {
      "fieldname": "defaults_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_customer",
      "fieldtype": "Link",
      "label": "Default (Walk-in) Customer",
      "options": "Customer"
    },
    {
      "fieldname": "discount_section",
      "fieldtype": "Section Break",
      "label": "Discounts"
    },
    {
      "fieldname": "allow_discounts",
      "fieldtype": "Check",
      "label": "Allow Discounts",
      "default": "1"
    },
    {
      "fieldname": "max_discount_percent",
      "fieldtype": "Percent",
      "label": "Max Discount %",
      "default": "100",
      "depends_on": "allow_discounts",
      "description": "Highest discount a cashier may give on one sale (0-100)."
    },
    {
      "fieldname": "counter_section",
      "fieldtype": "Section Break",
      "label": "Counter Screen"
    },
    {
      "fieldname": "product_view",
      "fieldtype": "Select",
      "label": "Product List",
      "options": "Grid\nRow",
      "default": "Grid",
      "description": "How the POS lists products. A cashier can switch it on the device."
    },
    {
      "fieldname": "counter_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "allow_price_change",
      "fieldtype": "Check",
      "label": "Allow Cashier to Change Prices",
      "default": "0",
      "description": "A price below the item's list price is still refused unless the user has a price-override role."
    },
    {
      "fieldname": "payments_tab",
      "fieldtype": "Tab Break",
      "label": "Payments"
    },
    {
      "fieldname": "payment_section",
      "fieldtype": "Section Break",
      "label": "Payment methods"
    },
    {
      "fieldname": "default_payment_mode",
      "fieldtype": "Link",
      "label": "Default Mode of Payment",
      "options": "Mode of Payment"
    },
    {
      "fieldname": "allow_split_payment",
      "fieldtype": "Check",
      "label": "Allow Split Payment",
      "default": "1",
      "description": "Let one sale be paid with more than one mode of payment."
    },
    {
      "fieldname": "payment_help",
      "fieldtype": "HTML",
      "options": "Accounts and gateways are set in <a href=\"/desk/zg-payment-settings\">ZG Payment Settings</a>; the modes themselves in <a href=\"/desk/mode-of-payment\">Mode of Payment</a>."
    },
    {
      "fieldname": "receipt_tab",
      "fieldtype": "Tab Break",
      "label": "Receipt & Printing"
    },
    {
      "fieldname": "receipt_section",
      "fieldtype": "Section Break",
      "label": "Receipt"
    },
    {
      "fieldname": "receipt_header",
      "fieldtype": "Small Text",
      "label": "Receipt Header"
    },
    {
      "fieldname": "receipt_footer",
      "fieldtype": "Small Text",
      "label": "Receipt Footer"
    },
    {
      "fieldname": "receipt_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "show_tax_on_receipt",
      "fieldtype": "Check",
      "label": "Show Tax Breakdown on Receipt",
      "default": "1"
    },
    {
      "fieldname": "print_copies",
      "fieldtype": "Int",
      "label": "Receipt Copies",
      "default": "1"
    },
    {
      "fieldname": "paper_size",
      "fieldtype": "Select",
      "label": "Invoice Paper",
      "options": "80mm\nA4",
      "default": "80mm",
      "description": "80mm roll receipt or A4 tax invoice. A cashier can switch it when printing."
    },
    {
      "fieldname": "invoice_qr",
      "fieldtype": "Select",
      "label": "ZATCA QR on Invoice",
      "options": "Phase 1\nOff",
      "default": "Phase 1",
      "description": "Phase 1 is built on the device from seller, VAT number, time, total and VAT. A Phase 2 QR from the ZATCA Integration app replaces it once the invoice is stamped."
    },
    {
      "fieldname": "printing_help",
      "fieldtype": "HTML",
      "options": "Printers are set in <a href=\"/desk/zg-printer-settings\">ZG Printer Settings</a>."
    },
    {
      "fieldname": "offline_tab",
      "fieldtype": "Tab Break",
      "label": "Offline"
    },
    {
      "fieldname": "offline_section",
      "fieldtype": "Section Break",
      "label": "Selling without a connection"
    },
    {
      "fieldname": "offline_enabled",
      "fieldtype": "Check",
      "label": "Allow Offline Counter Sales",
      "default": "0",
      "description": "The POS keeps selling at the counter (Supermarket, General Retail and the Counter channel of Restaurant and Cafe) when the connection drops, keeps the sales on the device and posts them when it is back. Tables, kitchen tickets and delivery always need the connection."
    },
    {
      "fieldname": "max_offline_hours",
      "fieldtype": "Int",
      "label": "Longest Offline Period (hours)",
      "default": "72",
      "description": "A sale older than this when it reaches the server is not posted; it waits for a manager. The POS also stops selling offline after this long."
    },
    {
      "fieldname": "max_pending_sales",
      "fieldtype": "Int",
      "label": "Most Sales Waiting on a Device",
      "default": "500",
      "description": "The POS stops taking offline sales when this many are waiting to be posted."
    },
    {
      "fieldname": "offline_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "snapshot_refresh_minutes",
      "fieldtype": "Int",
      "label": "Refresh Items and Prices Every (minutes)",
      "default": "15",
      "description": "How often a connected POS refreshes the copy of the catalog, customers and settings it sells from when offline."
    },
    {
      "fieldname": "allow_card_offline",
      "fieldtype": "Check",
      "label": "Allow Card and Wallet Sales Offline",
      "default": "0",
      "description": "Off: only cash is taken offline. The POS cannot check a card payment without a connection."
    },
    {
      "fieldname": "offline_help",
      "fieldtype": "HTML",
      "options": "A sale made offline is posted with its original date and time. If prices, tax or stock changed meanwhile it is still posted, at the server's figures, and listed under <a href=\"/desk/zg-offline-sale-issue\">Offline Sale Issues</a> for a manager to review."
    }
  ],
