      "label": "Dashboard defaults"
    },
    {
      "fieldname": "default_company",
      "fieldtype": "Link",
      "label": "Default Company",
      "options": "Company",
      "description": "The company the MyBis app opens on, when the user has no company of their own."
    },
    {
      "fieldname": "default_preset",
      "fieldtype": "Select",
      "label": "Default Period",
      "options": "today\nyesterday\nthis_week\nlast_week\nthis_month\nlast_month\nthis_quarter\nlast_quarter\nthis_year\nlast_year",
      "default": "this_month",
      "description": "The period the MyBis dashboard opens on, for a user who has not chosen their own in the app."
    },
    {
      "fieldname": "refresh_section",
      "fieldtype": "Section Break",
      "label": "Limits for users: refresh and alerts",
      "description": "Each user still picks their own value in the app, inside these limits."
    },
    {
      "fieldname": "min_refresh_minutes",
      "fieldtype": "Int",
      "label": "Shortest Auto-refresh (minutes)",
      "default": "0",
      "non_negative": 1,
      "description": "A user who turns on automatic refresh cannot choose an interval shorter than this. 0 = no limit. \"Only when I refresh\" is always allowed."
    },
    {
      "fieldname": "min_alert_severity",
      "fieldtype": "Select",
      "label": "Lowest Alert Severity Shown",
      "options": "low\nmedium\nhigh\ncritical",
      "default": "low",
      "description": "Alerts and insights below this severity are hidden in the app and never counted as new."
    },
    {
      "fieldname": "cards_section",
      "fieldtype": "Section Break",
      "label": "Limits for users: dashboard cards",
